[Unit]
Description=WatchDog LPR - monitoramento de placas e limpeza automatica
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ajuste User/Group e os caminhos abaixo conforme o servidor de destino.
User=watchdog
Group=watchdog
WorkingDirectory=/opt/watchdog_lpr
EnvironmentFile=/opt/watchdog_lpr/.env
ExecStart=/opt/watchdog_lpr/venv/bin/python /opt/watchdog_lpr/WatchDog.py
Restart=on-failure
RestartSec=10
# Código 2 = erro de configuração no .env (ex: FTP_HOST ausente): reiniciar não resolve.
RestartPreventExitStatus=2

# systemd envia SIGTERM no stop; o WatchDog.py trata esse sinal para um encerramento limpo.
# O tempo de parada cobre uma operação de FTP em andamento (FTP_TIMEOUT_SECONDS).
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
