# Servidor FTP onde o equipamento de LPR grava as imagens
FTP_HOST=192.168.10.3
FTP_PORT=21
FTP_USERNAME=
FTP_PASSWORD=
# Pasta, dentro do servidor FTP, que contém diretamente as pastas de placa
# (PLACA/DATA&COR&PORTAO.vehicleBody.jpg)
FTP_PATH=/
# Modo passivo (recomendado; use false apenas se o servidor exigir modo ativo)
FTP_PASSIVE=true
# FTP sobre TLS (FTPS explícito)
FTP_TLS=false
# Tempo máximo (segundos) de espera por resposta do servidor
FTP_TIMEOUT_SECONDS=30
# Codificação dos nomes de arquivo (use latin-1 se o servidor não trabalhar em UTF-8)
FTP_ENCODING=utf-8

# Banco de dados MySQL
DB_HOST=localhost
DB_DATABASE=watchdog_lpr
DB_USERNAME=watchdog_lpr
DB_PASSWORD=

# Intervalo (segundos) entre as varreduras do FTP em busca de arquivos novos
SCAN_INTERVAL_SECONDS=5

# Limpeza automática de arquivos antigos no FTP (RETENTION_DAYS=0 desativa)
RETENTION_DAYS=15
CLEANUP_INTERVAL_SECONDS=3600
# Só arquivos com estas extensões são removidos pela limpeza
CLEANUP_EXTENSIONS=.jpg,.jpeg

# Logging
LOG_LEVEL=INFO
LOG_FILE=log.log
