# Pasta monitorada: a raiz onde o equipamento de LPR grava as imagens via FTP.
# Deve conter diretamente as pastas de placa (PLACA/DATA&COR&PORTAO.vehicleBody.jpg).
# O install.sh ajusta este valor para a pasta do usuário FTP.
FOLDER_PATH=/srv/lpr

# Banco de dados MySQL
DB_HOST=localhost
DB_DATABASE=watchdog_lpr
DB_USERNAME=watchdog_lpr
DB_PASSWORD=

# Intervalo (segundos) entre as varreduras da pasta em busca de arquivos novos
SCAN_INTERVAL_SECONDS=5
# Tempo (segundos) sem modificação para considerar que o upload do arquivo terminou
FILE_SETTLE_SECONDS=3

# Limpeza automática de arquivos antigos (RETENTION_DAYS=0 desativa)
RETENTION_DAYS=15
CLEANUP_INTERVAL_SECONDS=3600
# Só arquivos com estas extensões são removidos pela limpeza
CLEANUP_EXTENSIONS=.jpg,.jpeg

# Logging
LOG_LEVEL=INFO
LOG_FILE=log.log
