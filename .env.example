# Pasta monitorada (no Linux, geralmente o ponto de montagem do compartilhamento
# de rede do LPR, ex: /mnt/lpr — veja o exemplo de fstab no README.md)
FOLDER_PATH=/mnt/lpr

# Banco de dados MySQL
DB_HOST=localhost
DB_DATABASE=watchdog_lpr
DB_USERNAME=watchdog_lpr
DB_PASSWORD=

# Limpeza automática de arquivos antigos
RETENTION_DAYS=15
CLEANUP_INTERVAL_SECONDS=3600

# Intervalo (segundos) do loop principal / checagem de encerramento
LOOP_INTERVAL_SECONDS=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=log.log
